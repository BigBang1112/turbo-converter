{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TurboConverterCLI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build TurboConverterCLI",
      "program": "${workspaceFolder}/TurboConverterCLI/bin/Debug/net10.0/TurboConverterCLI.dll",
      "args": ["${input:mapPath}"],
      "cwd": "${workspaceFolder}/TurboConverterCLI",
      "console": "integratedTerminal",
      "launchSettingsProfile": "TurboConverterCLI"
    }
  ],
  "inputs": [
    {
      "id": "mapPath",
      "type": "promptString",
      "description": "Map or folder path"
    }
  ]
}
